  "style_profile": {
    "definition": "金麦、草绿与胡桃棕包围人物，柔光与长镜把文学化为流动的油画。",
    "lighting": "黄金时刻侧逆光与窗纱漫射；肤色奶油暖调，发丝镶金边，空气微粒可见。",
    "framing": "长镜头跟拍、对称构图、门框透视；先交代空间氛围，再潜入人物内心。",
    "grading": "高光暖金，阴影绿棕；回忆片段偏暖饱和，现实片段偏冷压抑，对比推动叙事。",
    "avoid": "硬直射光、现代冷白调色、快速切镜碎切、手持晃动、用统一滤镜替代光线、场景和表演"
  }
