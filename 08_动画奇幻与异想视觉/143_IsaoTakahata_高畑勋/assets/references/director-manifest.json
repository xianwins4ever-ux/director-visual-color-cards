{
  "director": {"zh": "高畑勋", "en": "Isao Takahata"},
  "style_profile": {
    "definition": "水彩留白、泥土暖色与季节光线让悲伤保持人性温度。",
    "lighting": "柔漫射自然光，避免亮面反射，保留纸张和手绘颜料的呼吸感。",
    "framing": "观察式中景，让动作完整发生，先交代环境再进入人物。",
    "grading": "低对比、轻纸感、颜色边缘柔和，强调色只在情绪转折出现。",
    "avoid": ["高饱和动漫光", "金属锐化", "霓虹描边", "无动机环绕和随机变焦", "用统一滤镜替代色彩比例、光源和材质"]
  },
