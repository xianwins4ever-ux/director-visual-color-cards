  "style_profile": {
    "definition": "宝石绿、深红与冷黑在精密构图中制造欲望和危险。",
    "lighting": "雕刻感侧光、彩色实景光、深黑背景；肤色保持可读，不让环境偏色吞没面部层次。",
    "framing": "对称与倾斜并用，精确推拉和揭示；先交代颜色承载的空间，再进入人物与关键物件。",
    "grading": "深色浓郁、肤色克制、红绿分区；高光、中间调和阴影分别处理，局部强调色不污染全画面。",
    "avoid": "廉价紫粉霓虹、过亮肤色、随意手持、无动机环绕和随机变焦、用统一滤镜替代色彩比例、光源和材质。"
  }
