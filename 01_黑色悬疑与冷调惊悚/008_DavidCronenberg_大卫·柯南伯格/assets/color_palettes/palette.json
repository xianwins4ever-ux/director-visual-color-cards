  "style_profile": {
    "definition": "肉色、金属灰和病态蓝绿让身体与机器互相污染。",
    "lighting": "冷医疗光、湿润高光、低调侧光。",
    "framing": "临床近景、身体细节、冷静观察。",
    "grading": "突出皮肤纹理、有机湿感和金属表面，综合色不过艳。",
    "avoid": "干净科幻蓝、塑料血肉、美颜磨皮、全局青橙、无动机环绕和随机变焦"
  }
