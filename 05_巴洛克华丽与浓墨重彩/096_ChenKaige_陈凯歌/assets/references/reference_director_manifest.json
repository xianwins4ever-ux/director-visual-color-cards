  "style_profile": {
    "definition": "土黄历史空间中以戏服红蓝和舞台金连接个人命运与时代。",
    "lighting": "尘雾自然光与舞台暖光对照；肤色保持可读，不让环境偏色吞没面部层次。",
    "framing": "纵深群像、舞台正面构图、克制推进；先交代颜色承载的空间，再进入人物与关键物件。",
    "grading": "暖土中间调，红蓝局部浓烈；高光、中间调和阴影分别处理，局部强调色不污染全画面。",
    "avoid": [
      "现代 LED 色",
      "塑料古装",
      "无层次暖黄",
      "无动机环绕和随机变焦",
      "用统一滤镜替代色彩比例、光源和材质"
    ]
  },
