  "style_profile": {
    "definition": "兰斯莫斯的视觉风格以烛光照明为主，烛光暖调、古典油画色、鱼眼畸变色，营造出荒诞主义的氛围。",
    "lighting": "烛光照明，高光偏自然窗光，阴影偏低照度室内，整体暖调。",
    "composition": [],
    "mood": [],
    "framing": "鱼眼广角、畸变构图、古典宫廷，强调视觉层次感。",
    "grading": "对比度高对比，色调暖调，色彩烛光暖调、古典油画色、鱼眼畸变色。",
    "avoid": "避免平淡无奇、避免低饱和度、避免构图简单"
  }
