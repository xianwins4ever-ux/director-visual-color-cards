{
  "director": {"zh": "蔡明亮", "en": "Tsai Ming-liang"},
  "style_profile": {
    "definition": "霉绿、积水灰和病态荧光让城市身体处于缓慢腐蚀。",
    "lighting": "长时间实景荧光和阴湿自然光；肤色保持可读，不让环境偏色吞没面部层次。",
    "framing": "固定长镜、空空间、人物缓慢进入离开；先交代颜色承载的空间，再进入人物与关键物件。",
    "grading": "压低亮度和彩度，保留潮湿反光；高光、中间调和阴影分别处理，局部强调色不污染全画面。",
    "avoid": ["洁净极简", "明快糖果色", "快速蒙太奇", "无动机环绕和随机变焦", "用统一滤镜替代色彩比例、光源和材质"]
  },
