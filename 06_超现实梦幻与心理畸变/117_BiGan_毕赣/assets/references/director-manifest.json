  "style_profile": {
    "definition": "潮湿青绿、夜蓝和暖红在长镜中把现实滑入梦境。",
    "lighting": "潮湿夜光、局部钨丝、雾中散射；肤色保持可读，不让环境偏色吞没面部层次。",
    "framing": "长镜头环绕与空间折叠，运动缓慢；先交代颜色承载的空间，再进入人物与关键物件。",
    "grading": "阴影青蓝，高光暖金，红色作记忆钉点；高光、中间调和阴影分别处理，局部强调色不污染全画面。",
    "avoid": ["无目的长镜", "赛博高亮", "过曝雨夜", "无动机环绕和随机变焦", "用统一滤镜替代色彩比例、光源和材质"]
  },
